{{ ansible_managed | comment }}
[Unit]
Description=smokeng
Documentation=https://github.com/{{ smokeng_repo }}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ smokeng_user }}
Group={{ smokeng_group }}
ExecStart={{ smokeng_bin }} serve \
    --db {{ smokeng_db }} \
    --listen {{ smokeng_listen }}{% if smokeng_external_url | length > 0 %} \
    --external-url {{ smokeng_external_url }}{% endif %}{% if smokeng_trusted_proxies | length > 0 %} \
    --trusted-proxies {{ smokeng_trusted_proxies }}{% endif %}{% if smokeng_tls_ca_files | length > 0 %} \
    --tls-ca-file {{ smokeng_tls_ca_files }}{% endif %}{% if smokeng_irtt_hmac_keys | length > 0 %} \
    --irtt-hmac-keys {{ smokeng_irtt_hmac_keyfile }}{% endif %}{% if smokeng_allow_unauthenticated | bool %} \
    --i-know-this-is-unauthenticated{% endif %}{% if smokeng_metrics_public | bool %} \
    --metrics-public{% endif %}{% if smokeng_alert_webhook | length > 0 and _smokeng_new_flags | bool %} \
    --alert-webhook-file {{ smokeng_alert_webhook_file }}{% elif smokeng_alert_webhook | length > 0 %} \
    --alert-webhook {{ smokeng_alert_webhook }}{% endif %} \
    --default-role {{ smokeng_default_role }}{% if smokeng_oidc_issuer | length > 0 %} \
    --oidc-issuer {{ smokeng_oidc_issuer }} \
    --oidc-client-id {{ smokeng_oidc_client_id }} \
    --oidc-client-secret-file {{ smokeng_oidc_client_secret_file }} \
    --oidc-admin-claim {{ smokeng_oidc_admin_claim }}{% if smokeng_oidc_redirect_url | length > 0 %} \
    --oidc-redirect-url {{ smokeng_oidc_redirect_url }}{% endif %}{% if smokeng_oidc_admin_value | length > 0 %} \
    --oidc-admin-value {{ smokeng_oidc_admin_value }}{% endif %}{% if smokeng_oidc_everyone_is_admin | bool and _smokeng_new_flags | bool %} \
    --oidc-everyone-is-admin{% endif %}{% endif %}

Restart=always
RestartSec=5

# smokeng needs no privileges beyond the ping_group_range sysctl this role
# sets, so it can be locked down hard. NoNewPrivileges is compatible with
# unprivileged datagram ICMP; it is *not* compatible with the CAP_NET_RAW
# fallback, so if you drop the sysctl you must drop this line too and add
# AmbientCapabilities=CAP_NET_RAW instead.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths={{ smokeng_state_dir }}

# Tried one at a time on a Linux host under the same ping_group_range this role
# sets: the master measuring icmp, tcp, http and dns targets with path discovery
# running, and the prober measuring an icmp target through the master. Every
# interval arrived and nothing was refused.
ProtectClock=true
ProtectKernelLogs=true
ProtectHostname=true
# Needs systemd 247; an older one logs that it ignores it. Hides other users'
# processes, and leaves /proc/net/icmp alone, which is where the kernel's drop
# counter lives (see below).
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictRealtime=true
RemoveIPC=true
SystemCallArchitectures=native
UMask=0077
# No capabilities at all. ICMP goes over unprivileged datagram sockets (the
# sysctl this role sets), so none is needed. If you use the CAP_NET_RAW fallback
# instead (see docs/operations.md), this must become CapabilityBoundingSet=CAP_NET_RAW
# next to AmbientCapabilities=CAP_NET_RAW: with it empty the unit still starts, and
# the ambient capability is dropped without an error.
CapabilityBoundingSet=

# Deliberately absent:
#
# ProcSubset=pid  Hides /proc/net, where the kernel's per-socket drop counter
#   lives. smokeng still runs and still measures, but logs "drop counter
#   unavailable" and can no longer tell a reply the kernel dropped for lack of
#   queue space from one the network lost, so its loss figures claim more than
#   they know.
# SystemCallFilter=  Worked for icmp, tcp, http, dns and path discovery, but irtt,
#   https and the alert webhook were not tried under it, and a syscall refused
#   there fails one probe type quietly. If you add it, run with
#   SystemCallErrorNumber=EPERM first and watch the log.
# PrivateUsers=  Worked on one kernel; ICMP socket permission is checked against
#   group ids, and its behaviour in a user namespace has changed between kernels.

[Install]
WantedBy=multi-user.target
