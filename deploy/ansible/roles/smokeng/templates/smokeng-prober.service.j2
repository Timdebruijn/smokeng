{{ ansible_managed | comment }}
# The prober as its own process, on the same host as the master.
#
# smokeng's single binary runs the scheduler, the probing engine, the database
# and the web UI together, which is the right shape for one host. This unit is
# for when it is not: restarting the UI without interrupting measurement,
# upgrading the two on different schedules, or giving the prober the ICMP
# permission the UI has no business holding.
#
# It is the ordinary remote-agent path pointed at loopback — the same signed
# ingest a prober in another datacentre uses, so there is one code path and not
# a second local-only one. That is also its cost: measurements travel over HTTP
# and are signed and verified rather than handed to the writer directly.
#
# Plain HTTP over loopback needs no flag: those packets never reach a network
# interface, so there is nothing for TLS to protect them from.
#
# No --tls-ca-file either: the master hands its CAs down with the assignments,
# which is the same file smokeng_tls_ca_files already placed for the master.
#
# Assign targets to it by setting `agents` to this agent's name. The master
# keeps its own built-in prober ("local"); a target names one or the other.
[Unit]
Description=smokeng prober ({{ smokeng_prober_agent_name }})
Documentation=https://github.com/{{ smokeng_repo }}
After=network-online.target smokeng.service
Wants=network-online.target
# Not Requires: the prober keeps measuring into its own buffer while the
# master is down, and drains when it comes back. Tying its lifetime to the
# master's would throw away exactly the measurements taken during the outage.
After=smokeng.service

[Service]
Type=simple
User={{ smokeng_user }}
Group={{ smokeng_group }}
ExecStart={{ smokeng_bin }} agent run \
    --master {{ smokeng_prober_master_url }} \
    --agent-id {{ smokeng_prober_agent_id }} \
    --key {{ smokeng_prober_key }} \
    --db {{ smokeng_prober_db }}{% if smokeng_irtt_hmac_keys | length > 0 %} \
    --irtt-hmac-keys {{ smokeng_irtt_hmac_keyfile }}{% endif %}


Restart=always
RestartSec=5

# Same lockdown as the master. The prober is the half that needs the ICMP
# sysctl; it is here rather than there once measurement moves out.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths={{ smokeng_state_dir }}

# Tried one at a time on a Linux host under the same ping_group_range this role
# sets: the master measuring icmp, tcp, http and dns targets with path discovery
# running, and the prober measuring an icmp target through the master. Every
# interval arrived and nothing was refused.
ProtectClock=true
ProtectKernelLogs=true
ProtectHostname=true
# Needs systemd 247; an older one logs that it ignores it. Hides other users'
# processes, and leaves /proc/net/icmp alone, which is where the kernel's drop
# counter lives (see below).
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictRealtime=true
RemoveIPC=true
SystemCallArchitectures=native
UMask=0077
# No capabilities at all. ICMP goes over unprivileged datagram sockets (the
# sysctl this role sets), so none is needed. If you use the CAP_NET_RAW fallback
# instead (see docs/operations.md), this must become CapabilityBoundingSet=CAP_NET_RAW
# next to AmbientCapabilities=CAP_NET_RAW: with it empty the unit still starts, and
# the ambient capability is dropped without an error.
CapabilityBoundingSet=

# Deliberately absent:
#
# ProcSubset=pid  Hides /proc/net, where the kernel's per-socket drop counter
#   lives. smokeng still runs and still measures, but logs "drop counter
#   unavailable" and can no longer tell a reply the kernel dropped for lack of
#   queue space from one the network lost, so its loss figures claim more than
#   they know.
# SystemCallFilter=  Worked for icmp, tcp, http, dns and path discovery, but irtt,
#   https and the alert webhook were not tried under it, and a syscall refused
#   there fails one probe type quietly. If you add it, run with
#   SystemCallErrorNumber=EPERM first and watch the log.
# PrivateUsers=  Worked on one kernel; ICMP socket permission is checked against
#   group ids, and its behaviour in a user namespace has changed between kernels.

[Install]
WantedBy=multi-user.target
